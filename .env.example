# App
BOT_PORT=8000
WAHA_PORT=3000
QDRANT_PORT=6333
BUSINESS_NAME=

# Used only when the contact's language cannot be detected.
FALLBACK_LANGUAGE=Spanish


# WAHA
# Inside compose use http://waha:3000, from the host http://localhost:3000
WAHA_URL=http://waha:3000
WAHA_SESSION=default
DEBOUNCE_SECONDS=6

WAHA_API_KEY=

# openssl rand -hex 32
WEBHOOK_SECRET=


# OpenAI
OPENAI_API_KEY=

# Must accept image input.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# gpt-5.6-terra rejects this parameter, verified. Only set it for models that accept it.
# OPENAI_TEMPERATURE=0.3


# Qdrant
# Inside compose use http://qdrant:6333, from the host http://localhost:6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_KNOWLEDGE_COLLECTION=knowledge
QDRANT_MEMORY_COLLECTION=memory
SPARSE_EMBEDDING_MODEL=Qdrant/bm25


# Retrieval
KNOWLEDGE_TOP_K=6
MEMORY_TOP_K=6
MEMORY_RECENT_TURNS=10


# WAHA container only, not read by the app
WAHA_DASHBOARD_USERNAME=waha
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=waha
WHATSAPP_SWAGGER_PASSWORD=
