# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────

# Host ports. Change these if something already listens there, the containers
# keep talking to each other on 3000, 6333 and 8000 regardless.
BOT_PORT=8000
WAHA_PORT=3000
QDRANT_PORT=6333

# Name the bot introduces itself with.
BUSINESS_NAME=Innovacar

# The bot always replies in the language the contact writes in. This is only
# used when that language cannot be determined.
FALLBACK_LANGUAGE=Spanish


# ─────────────────────────────────────────────────────────────
# WAHA  (WhatsApp HTTP API)
# ─────────────────────────────────────────────────────────────

# Reachable from THIS process, not from inside the waha container.
#   app on host, waha in docker  -> http://localhost:3000
#   both in docker compose       -> http://waha:3000
WAHA_URL=http://waha:3000

# CREDENTIAL. Protects the WAHA API. Empty disables auth, do not ship it empty.
WAHA_API_KEY=

# Session name. WAHA Core only supports "default".
WAHA_SESSION=default

# CREDENTIAL. Signs incoming webhooks, must match WHATSAPP_HOOK_HMAC_KEY on the
# waha container. Generate one with:  openssl rand -hex 32
WEBHOOK_SECRET=

# Seconds to wait for more messages before answering, so three quick messages
# become one reply instead of three.
DEBOUNCE_SECONDS=6


# ─────────────────────────────────────────────────────────────
# OpenAI
# ─────────────────────────────────────────────────────────────

# CREDENTIAL.
OPENAI_API_KEY=

# Chat model. Must accept image input, the bot reads photos contacts send.
OPENAI_MODEL=gpt-5.6-terra

# Embedding model. Changing it invalidates every collection, re-ingest after.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Speech to text model for voice notes. Chat models do not transcribe.
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Left unset on purpose: newer models reject the parameter. Uncomment only if
# your model accepts it. 0.0 is deterministic, 1.0 is creative.
# OPENAI_TEMPERATURE=0.3


# ─────────────────────────────────────────────────────────────
# Qdrant  (vector database)
# ─────────────────────────────────────────────────────────────

#   app on host, qdrant in docker -> http://localhost:6333
#   both in docker compose        -> http://qdrant:6333
QDRANT_URL=http://qdrant:6333

# CREDENTIAL. Only needed for Qdrant Cloud, leave empty when self hosting.
QDRANT_API_KEY=

# Knowledge base ingested from your own documents.
QDRANT_KNOWLEDGE_COLLECTION=knowledge

# Conversation memory, one point per message, filtered by chat id.
QDRANT_MEMORY_COLLECTION=memory

# Sparse model for the keyword half of hybrid search. Runs locally on cpu.
SPARSE_EMBEDDING_MODEL=Qdrant/bm25


# ─────────────────────────────────────────────────────────────
# Retrieval tuning
# ─────────────────────────────────────────────────────────────

# Documents pulled from the knowledge base per question.
KNOWLEDGE_TOP_K=6

# Past messages semantically recalled for this contact.
MEMORY_TOP_K=6

# Most recent messages always included, regardless of relevance.
MEMORY_RECENT_TURNS=10


# ─────────────────────────────────────────────────────────────
# WAHA container only
# Read by docker compose, not by the app. Ignored when running locally.
# ─────────────────────────────────────────────────────────────

WAHA_DASHBOARD_USERNAME=waha

# CREDENTIAL. Protects the dashboard at http://localhost:3000/dashboard
WAHA_DASHBOARD_PASSWORD=

WHATSAPP_SWAGGER_USERNAME=waha

# CREDENTIAL. Protects the swagger docs at http://localhost:3000
WHATSAPP_SWAGGER_PASSWORD=
